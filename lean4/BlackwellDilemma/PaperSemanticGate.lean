        bridge /\
      harrisKestenCriticalProb < bridge.supercriticalProbability /\
      0 <= bridge.supercriticalProbability /\
      bridge.supercriticalProbability < 1 /\
      (Exists fun c : Real =>
        0 < c /\ c <= 1 /\
          Exists fun L0 : Nat =>
