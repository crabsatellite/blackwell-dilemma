            0 <= (bridge.family L).topoLossKernel n omega /\
              (bridge.family L).topoLossKernel n omega <= 1) /\
      BoxedTorusFlatFamilyCoreConclusion bridge.family /\
      BoxedTorusFlatUnitCompatibleAboveThresholdLowerBoundConclusion
        bridge.family

